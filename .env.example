# Copy to .env.local and fill in. Never commit .env.local.
# None of these use the NEXT_PUBLIC_ prefix, so they are never sent to the browser.

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq (fallback when Gemini fails or rate-limits): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Supabase: Project Settings -> API. Use the service_role key (server-side only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
